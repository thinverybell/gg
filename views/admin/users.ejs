<% const body=`<div class="admin-card"><h2>Thêm người dùng</h2><form method="post" action="/admin/users" class="form-grid"><input name="name" placeholder="Tên"><input name="email" type="email" required placeholder="Email"><input name="password" placeholder="Mật khẩu"><select name="role"><option value="client">Client</option><option value="admin">Admin</option></select><input name="balance" type="number" placeholder="Số dư"><button class="btn primary">Thêm</button></form></div><div class="admin-card"><h2>Danh sách</h2><table><tr><th>ID</th><th>Tên</th><th>Email</th><th>Quyền</th><th>Trạng thái</th><th></th></tr>${users.map(u=>`<tr><td>${u.id}</td><td>${u.name}</td><td>${u.email}</td><td>${u.role}</td><td>${u.status}</td><td><form method="post" action="/admin/users/${u.id}/toggle"><button class="btn">${u.status==='active'?'Tắt':'Bật'}</button></form></td></tr>`).join('')}</table></div>`; %><%- include('layout',{title:'Người dùng',body}) %>