<% const body=`<div class="admin-card"><h2>Thêm thông báo</h2><form method="post" action="/admin/notifications" class="form-stack"><input name="title" required placeholder="Tiêu đề"><textarea name="message" required placeholder="Nội dung"></textarea><button class="btn primary">Đăng</button></form></div><div class="admin-card">${notifications.map(x=>`<article class="notice"><b>${x.title}</b><p>${x.message}</p></article>`).join('')}</div>`; %><%- include('layout',{title:'Thông báo',body}) %>