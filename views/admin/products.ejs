<% const body=`<div class="admin-card"><h2>Thêm sản phẩm</h2><form method="post" action="/admin/products" class="form-grid"><input name="name" required placeholder="Tên sản phẩm"><input name="category" placeholder="Danh mục"><input name="price" type="number" placeholder="Giá"><input name="unit" placeholder="Đơn vị"><textarea name="description" placeholder="Mô tả"></textarea><button class="btn primary">Thêm</button></form></div><div class="admin-card"><h2>Sản phẩm</h2><table><tr><th>Tên</th><th>Nhóm</th><th>Giá</th><th>Mô tả</th></tr>${products.map(p=>`<tr><td>${p.name}</td><td>${p.category}</td><td>${p.price.toLocaleString('vi-VN')} ${p.unit}</td><td>${p.description}</td></tr>`).join('')}</table></div>`; %><%- include('layout',{title:'Sản phẩm',body}) %>