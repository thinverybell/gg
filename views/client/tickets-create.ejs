                                </a>
</div>
<form class="zc-tickets-filter" method="get">
<div class="zc-tickets-filter-grid">
<input class="form-control" name="q" placeholder="Tìm theo mã hoặc tiêu đề" type="text" value=""/>
<select class="form-control" name="status_id">
<option value="0">Tất cả trạng thái</option>
<option value="1">Mới</option>
<option value="2">Cảnh Báo</option>
<option value="3">Đang tiến hành</option>
<option value="4">Cảnh báo khách hàng</option>
<option value="5">Đã giải quyết</option>
<option value="6">Đóng</option>
</select>
<select class="form-control" name="department_id">
<option value="0">Tất cả phòng ban</option>
<option value="1">Kỹ Thuật</option>
<option value="2">Thanh Toán</option>
<option value="3">Kinh doanh</option>
<option value="6">Khi?u n?i</option>
<option value="5">Hỗ trợ chung</option>
</select>
<select class="form-control" name="priority_id">
<option value="0">Tất cả ưu tiên</option>
<option value="1">Thấp</option>
<option value="2">Bình Thường</option>
<option value="3">Cao</option>
<option value="4">Khẩn Cấp</option>
</select>
<button class="btn btn-primary" type="submit"><i class="fas fa-filter"></i> Lọc</button>
</div>
</form>
